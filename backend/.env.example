# Database
DATABASE_URL="postgresql://user:password@localhost:5432/receipts?schema=public"

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""

# AI Provider (options: mock, claude, gemini, openai)
AI_PROVIDER="claude"

# Anthropic Claude (included with Claude subscription)
ANTHROPIC_API_KEY=""

# Google Gemini (FREE tier available)
GEMINI_API_KEY=""

# OpenAI (requires payment)
OPENAI_API_KEY=""

# Server
PORT=3000
